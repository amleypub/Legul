{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Gli script di servizio girano su Node 22, che esegue TypeScript
    // rimuovendo i tipi: per farlo pretende l'estensione nell'import.
    // Metro compila con Babel, quindi noEmit non tocca la build dell'app.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": [
    "node_modules",
    "web-build",
    // Le Edge Function girano su Deno, con API e import via URL che il
    // TypeScript dell'app non conosce: hanno un ambiente tutto loro.
    "supabase/functions"
  ]
}
