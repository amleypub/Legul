# Copia questo file in `.env` e incolla i valori del tuo progetto Supabase.
# Li trovi in Supabase: Project Settings → API.
#
# Il prefisso EXPO_PUBLIC_ è obbligatorio, altrimenti Expo non include le
# variabili nel bundle. Sono chiavi pubbliche per costruzione: la chiave
# anonima è pensata per stare dentro l'app, la protezione dei dati la
# fanno le policy RLS del database (vedi docs/supabase.md).
#
# Senza queste variabili l'app funziona lo stesso: resta in modalità
# ospite, con i progressi salvati solo sul dispositivo.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=incolla-qui-la-chiave-anon
